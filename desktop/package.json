{
  "name": "codeshift-desktop",
  "productName": "CODE:SHIFT",
  "version": "0.8.0-rc.0",
  "private": true,
  "description": "Offline desktop shell for CODE:SHIFT",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:client": "node ../scripts/build-desktop.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:windows": "node scripts/package.mjs",
    "package:steam": "node scripts/package.mjs --steam"
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "@electron/packager": "20.3.0",
    "@electron/fuses": "2.1.3"
  },
  "author": "yw8837"
}
