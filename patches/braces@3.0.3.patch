diff --git a/lib/security.js b/lib/security.js
new file mode 100644
index 0000000..b87a40b
--- /dev/null
+++ b/lib/security.js
@@ -0,0 +1,85 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Hard ceilings also cover direct AST
+// entry points; caller options cannot disable these process resource limits.
+const MAX_DEPTH = 100;
+const MAX_NODES = 20000;
+const MAX_RESULTS = 10000;
+const MAX_WORK = 100000;
+const MAX_CHARS = 1000000;
+const fail = () => { throw new RangeError('braces resource limit exceeded'); };
+
+exports.checkDepth = depth => { if (depth > MAX_DEPTH) fail(); };
+exports.checkAst = ast => {
+  const pending = [{node: ast, depth: 0}];
+  let nodes = 0;
+  let chars = 0;
+  while (pending.length) {
+    const {node, depth} = pending.pop();
+    // Invalid/unclosed parsing can retain stale parents, so require bounded
+    // parent chains rather than parent identity. This also rejects cycles.
+    let ancestor = node;
+    let ancestorDepth = 0;
+    while (ancestor.parent) {
+      exports.checkDepth(++ancestorDepth);
+      ancestor = ancestor.parent;
+    }
+    exports.checkDepth(depth);
+    if (++nodes > MAX_NODES) fail();
+    // JSON AST values must remain scalar. Arrays/objects can otherwise be
+    // coerced into uncounted output when a parent concatenates their value.
+    if (node.value != null && !['string', 'number', 'boolean'].includes(typeof node.value)) fail();
+    if (typeof node.value === 'string') {
+      chars += node.value.length;
+      if (chars > MAX_CHARS) fail();
+    }
+    if (node.nodes) {
+      if (node.nodes.length + nodes + pending.length > MAX_NODES) fail();
+      for (const child of node.nodes) pending.push({node: child, depth: depth + 1});
+    }
+  }
+};
+
+exports.checkRange = (args, options, compile = false, budget) => {
+  // Parsed range tokens are scalar text. Direct AST values must not redirect
+  // fill-range's overload to an options object or a transform callback.
+  // Extra AST arguments would displace the caller's options object entirely.
+  if (args.length > 3) fail();
+  if (args.some(value => typeof value !== 'string' && typeof value !== 'number')) fail();
+  // An incomplete parsed range is literal syntax, not an enumerable range.
+  if (args.length < 2) return;
+  // Match fill-range's numeric coercion, including exponent, hexadecimal,
+  // signed and whitespace forms. A decimal-only regexp lets those bypass
+  // the guard while fill-range still enumerates an unsafe numeric range.
+  const numeric = args.slice(0, 2).every(value => Number.isInteger(Number(value)));
+  const a = numeric ? Number(args[0]) : String(args[0]).charCodeAt(0);
+  const b = numeric ? Number(args[1]) : String(args[1]).charCodeAt(0);
+  // Match the step that fill-range will actually use. Non-scalar options.step
+  // can otherwise select another overload and discard the regex settings.
+  const effectiveStep = args[2] || options.step || 1;
+  if (typeof effectiveStep !== 'string' && typeof effectiveStep !== 'number') fail();
+  const step = Math.max(Math.abs(Number(effectiveStep)), 1);
+  if (!Number.isSafeInteger(a) || !Number.isSafeInteger(b)) fail();
+  // Contiguous compiled ranges use a compact regex; stepped ranges enumerate.
+  const count = Math.floor(Math.abs(b - a) / step) + 1;
+  if ((!compile || step !== 1) && count > MAX_RESULTS) fail();
+  // Compiling several individually small stepped ranges must not enumerate
+  // an unlimited aggregate. Invalid steps are left to fill-range's checks.
+  if (budget && compile && step !== 1 && Number.isSafeInteger(count)) exports.work(budget, count);
+};
+
+exports.budget = () => ({work: 0, chars: 0});
+exports.work = (budget, amount = 1) => {
+  budget.work += amount;
+  if (!Number.isSafeInteger(budget.work) || budget.work > MAX_WORK) fail();
+};
+exports.append = (budget, value) => {
+  exports.work(budget);
+  if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
+    // Numeric/boolean JSON AST leaves retain their original return types,
+    // but their text contributes to a parent's string concatenation too.
+    budget.chars += String(value).length;
+    if (budget.chars > MAX_CHARS) fail();
+  }
+};
+exports.checkResults = result => { if (result.length > MAX_RESULTS) fail(); };
